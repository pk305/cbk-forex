{
  "name": "pk305/cbk-forex",
  "description": "A Laravel package that fetches and stores Central Bank of Kenya (CBK) foreign exchange rates with daily auto-updates.",
  "type": "library",
  "keywords": [
    "laravel",
    "cbk",
    "forex",
    "kenya",
    "exchange-rates",
    "currency"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Kennedy Peters",
      "email": "pknuek@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "phpunit/phpunit": "^10.0|^11.0",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "Pk305\\CbkForex\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pk305\\CbkForex\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pk305\\CbkForex\\CbkForexServiceProvider"
      ],
      "aliases": {
        "CbkForex": "Pk305\\CbkForex\\Facades\\CbkForex"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
